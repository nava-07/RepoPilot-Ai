# Copy to .env (backend/.env). No secrets are required for the default local setup.
REPOPILOT_HOST=127.0.0.1
REPOPILOT_PORT=8000
REPOPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty, then select an installed model in Settings (or set e.g. the tag you pulled).
REPOPILOT_OLLAMA_MODEL=
REPOPILOT_OLLAMA_TIMEOUT_SECONDS=10
# Comma-separated absolute paths RepoPilot may read repositories from.
REPOPILOT_AUTHORIZED_ROOTS=
